# Copy this file to .env and replace the placeholders.
# .env is ignored by Git; .env.example is safe to commit.

# Web UI publishing.
APP_PORT=8085
CONTAINER_NAME=gledopto-effects
API_CONTAINER_NAME=gledopto-api
IMAGE_NAME=gledopto-effect-lab:latest
HTML_HOST_PATH=/opt/gledopto-effects

# Camera stream reachable from the Docker host. Rendered into nginx.conf.template.
CAMERA_URL=http://camera.example.local:8080/video

# Compose service name of the API in the same stack. nginx resolves it on the
# stack network; no host port is needed for the API.
API_UPSTREAM=http://gledopto-api:8000/api/

# Used by server.py only. HA_TOKEN is a secret and must stay out of Git.
HA_URL=
HA_TOKEN=
ESPHOME_SERVICE=esphome/led_dimmer_wifi_01_send_tuya_command
SAVED_FILE_PATH=/data/saved_effects.json
